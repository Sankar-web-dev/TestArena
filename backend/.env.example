# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/online_test_platform

# Better Auth — the PUBLIC base URL of THIS backend server
# (dev: http://localhost:3006, prod: your deployed backend URL).
# It has nothing to do with the database.
BETTER_AUTH_URL=http://localhost:3006
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Port the backend listens on
PORT=3006

# Frontend origin(s) allowed to call this API (comma-separated)
FRONTEND_URL=http://localhost:3005
